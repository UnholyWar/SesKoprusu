<Window x:Class="SesKoprusu.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SesKöprüsü" Width="410" MinWidth="370" SizeToContent="Height" MaxHeight="720" FontFamily="Segoe UI" FontSize="14" Foreground="#F3EAFF" Closing="OnClosing">
 <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#090711"/><GradientStop Color="#2E1945" Offset=".68"/><GradientStop Color="#100D1C" Offset="1"/></LinearGradientBrush></Window.Background>
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#48305F"/><Setter Property="BorderBrush" Value="#80629F"/><Setter Property="Margin" Value="0,2,5,2"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,3"/><Setter Property="MinWidth" Value="135"/></Style>
 </Window.Resources>
 <Grid>
  <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity=".65"><Path Fill="#DECBFF" Data="M34,11 l1,4 4,1 -4,1 -1,4 -1,-4 -4,-1 4,-1 Z M211,25 l1,3 3,1 -3,1 -1,3 -1,-3 -3,-1 3,-1 Z M311,99 l1,3 3,1 -3,1 -1,3 -1,-3 -3,-1 3,-1 Z"/><Path Stroke="#AF8DD0" StrokeThickness="2" Data="M76,8h2 M160,17h1 M304,9h2 M360,52h1 M18,86h2 M262,126h2 M378,174h2 M35,206h2"/></Canvas>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,15">
   <DockPanel><Button x:Name="Nav" DockPanel.Dock="Right" Content="Codex Ayarları" Click="SettingsClick"/><TextBlock FontSize="23" FontWeight="SemiBold" Text="SesKöprüsü"/></DockPanel>
   <TextBlock x:Name="SessionState" Foreground="#D2B4EF" Margin="0,4,0,12" Text="Bağlantı kontrol ediliyor…" TextWrapping="Wrap"/>
   <StackPanel x:Name="HomePane">
    <DockPanel Margin="0,0,0,10"><ToggleButton x:Name="Route" DockPanel.Dock="Right" Width="48" Height="26" AutomationProperties.Name="Ses köprüsünü aç veya kapat" Click="RouteClick">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="#554B61" CornerRadius="13" Padding="3"><Ellipse x:Name="Thumb" Width="20" Fill="#FAF5FF" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9754DB"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton><TextBlock Text="Ses köprüsü" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
    <DockPanel Margin="0,2"><ComboBox DockPanel.Dock="Right" x:Name="Incoming" SelectionChanged="LanguageChanged" AutomationProperties.Name="Gelen sesin hedef dili"/><TextBlock Text="Gelen sesin hedef dili" VerticalAlignment="Center"/></DockPanel>
    <DockPanel Margin="0,2"><ComboBox DockPanel.Dock="Right" x:Name="Outgoing" SelectionChanged="LanguageChanged" AutomationProperties.Name="Giden sesin hedef dili"/><TextBlock Text="Giden sesin hedef dili" VerticalAlignment="Center"/></DockPanel>
   </StackPanel>
   <StackPanel x:Name="Settings" Visibility="Collapsed">
    <TextBlock Text="ChatGPT hesabı" FontWeight="SemiBold"/>
    <WrapPanel><Button x:Name="Login" Content="Cihaz koduyla giriş" Click="LoginClick"/><Button x:Name="Test" Content="Durumu yenile" Click="TestClick"/></WrapPanel>
    <WrapPanel><Button x:Name="Reconnect" Content="App Server’a yeniden bağlan" Click="ReconnectClick"/><Button Content="Hesap güvenliği ↗" Click="SecurityClick"/></WrapPanel>
    <StackPanel x:Name="Challenge" Visibility="Collapsed" Margin="0,6">
     <TextBlock Text="ChatGPT doğrulama sayfasında bu kodu girin."/>
     <TextBox x:Name="UserCode" IsReadOnly="True" FontSize="22" Padding="6" FontFamily="Consolas" AutomationProperties.Name="Tek kullanımlık cihaz kodu"/>
     <Button Content="ChatGPT doğrulama sayfasını aç ↗" Click="VerificationClick"/>
    </StackPanel>
    <Button x:Name="CancelLogin" Content="İptal" HorizontalAlignment="Left" Visibility="Collapsed" Click="CancelClick"/>
    <TextBlock Text="Kodu yalnızca kendi başlattığınız girişte kullanın. Kimseyle paylaşmayın." TextWrapping="Wrap" Margin="0,4,0,10"/>
    <TextBlock Text="OpenAI ses API anahtarı"/><PasswordBox x:Name="Key" PasswordChanged="KeyChanged" Padding="6" ToolTip="Yalnızca bu oturumda kullanılır"/>
    <TextBlock x:Name="SpeechState" Foreground="#D2B4EF" TextWrapping="Wrap" Margin="0,3,0,8"/>
    <DockPanel><Button x:Name="Preview" DockPanel.Dock="Right" Content="Örneği dinle" Click="PreviewClick"/><ComboBox x:Name="Voice" SelectionChanged="VoiceChanged" AutomationProperties.Name="Seslendirme sesi"/></DockPanel>
   </StackPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#E4CFF7" Margin="0,6,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
