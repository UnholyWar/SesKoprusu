<Window x:Class="SesKoprusu.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SesKöprüsü" Width="478" MinWidth="370" SizeToContent="Height" MaxHeight="720" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" Foreground="#F3EAFF" Closing="OnClosing">
 <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#101017"/><GradientStop Color="#191622" Offset=".68"/><GradientStop Color="#14131D" Offset="1"/></LinearGradientBrush></Window.Background>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#C8BCD7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabSurface" CornerRadius="6" Background="Transparent" Padding="13,7" Margin="0,0,4,6">
     <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#33273E"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#503563"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#CDA4F4"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Canvas IsHitTestVisible="False" ClipToBounds="True" Opacity=".29" Height="80" VerticalAlignment="Top"><Path Fill="#DECBFF" Data="M34,11 l1,4 4,1 -4,1 -1,4 -1,-4 -4,-1 4,-1 Z M211,25 l1,3 3,1 -3,1 -1,3 -1,-3 -3,-1 3,-1 Z M311,99 l1,3 3,1 -3,1 -1,3 -1,-3 -3,-1 3,-1 Z"/><Path Stroke="#AF8DD0" StrokeThickness="2" Data="M76,8h2 M160,17h1 M304,9h2 M360,52h1 M18,86h2 M262,126h2 M378,174h2 M35,206h2"/></Canvas>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,20">
   <DockPanel Margin="0,0,0,16">
    <Button x:Name="Nav" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Content="Codex Settings" Click="SettingsClick"/>
    <StackPanel>
     <TextBlock FontSize="24" FontWeight="SemiBold" Text="SesKöprüsü"/>
     <TextBlock x:Name="SessionState" Foreground="#C6B8D8" FontSize="12" Margin="0,3,0,0" Text="Checking connection…" TextWrapping="Wrap"/>
    </StackPanel>
   </DockPanel>
   <Border Background="#201C29" CornerRadius="12" Padding="16" BorderBrush="#3D3548" BorderThickness="1"
           Visibility="{Binding Visibility, ElementName=HomePane}">
   <StackPanel x:Name="HomePane">
    <DockPanel Margin="0,0,0,10"><ToggleButton x:Name="Route" DockPanel.Dock="Right" Width="48" Height="26" AutomationProperties.Name="Toggle audio routing" Click="RouteClick">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="#554B61" CornerRadius="13" Padding="3"><Ellipse x:Name="Thumb" Width="20" Fill="#FAF5FF" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9754DB"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton><TextBlock Text="Audio bridge" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
    <Border Background="#3D3548" Height="1" Margin="0,3,0,13"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Incoming audio" Margin="0,0,0,5"/><ComboBox x:Name="Incoming" SelectionChanged="LanguageChanged" AutomationProperties.Name="Incoming audio language"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Outgoing audio" Margin="0,0,0,5"/><ComboBox x:Name="Outgoing" SelectionChanged="LanguageChanged" AutomationProperties.Name="Outgoing audio language"/></StackPanel>
    </Grid>
   </StackPanel></Border>
   <StackPanel x:Name="Settings" Visibility="Collapsed">
    <TabControl Background="#201C29" BorderBrush="#3D3548" BorderThickness="1" Padding="18" Foreground="#F3EAFF">
     <TabItem Header="Account"><StackPanel TextElement.FontWeight="Normal" TextElement.Foreground="#F3EAFF">
    <TextBlock Text="ChatGPT account" Style="{StaticResource SectionTitle}"/>
    <WrapPanel><Button Style="{StaticResource Primary}" x:Name="Login" Content="Sign in with a device code" Click="LoginClick"/><Button x:Name="Test" Content="Refresh status" Click="TestClick"/></WrapPanel>
    <WrapPanel><Button x:Name="Reconnect" Content="Reconnect to App Server" Click="ReconnectClick"/><Button Content="Account security ↗" Click="SecurityClick"/></WrapPanel>
    <StackPanel x:Name="Challenge" Visibility="Collapsed" Margin="0,6">
     <TextBlock Text="Enter this code on the ChatGPT verification page."/>
     <TextBox Background="#15131D" Foreground="#F5ECFF" BorderBrush="#665775" x:Name="UserCode" IsReadOnly="True" FontSize="22" Padding="6" FontFamily="Consolas" AutomationProperties.Name="One-time device code"/>
    <TextBlock Text="Use this code only for your own sign-in. Never share it." TextWrapping="Wrap" Margin="0,4,0,10"/>
     <Button Content="Open verification page ↗" Click="VerificationClick"/>
    </StackPanel>
    <Button x:Name="CancelLogin" Content="Cancel" HorizontalAlignment="Left" Visibility="Collapsed" Click="CancelClick"/>

     </StackPanel></TabItem>
     <TabItem x:Name="DeviceTab" Header="Devices"><StackPanel TextElement.FontWeight="Normal" TextElement.Foreground="#F3EAFF">
    <TextBlock Text="Audio devices" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="Microphone translation" FontWeight="SemiBold" Margin="0,2,0,4"/>
    <TextBlock x:Name="MicPath" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,5,0,8"><Button x:Name="MicSetup" Style="{StaticResource Primary}" Click="RepairClick" Visibility="Collapsed"/><Button Content="Windows sound settings ↗" Click="SoundSettingsClick"/></WrapPanel>
    <Separator Margin="0,4,0,8"/>
    <TextBlock x:Name="DriverState" TextWrapping="Wrap" Margin="0,3"/>
    <WrapPanel><Button Style="{StaticResource Primary}" x:Name="Repair" Visibility="Collapsed" Content="Set up driver" Click="RepairClick"/><Button x:Name="ImportPackage" Visibility="Collapsed" Content="Use downloaded ZIP…" Click="RepairClick"/><Button x:Name="DeviceRefresh" Content="Refresh devices" Click="RefreshDevicesClick"/><Button x:Name="License" Visibility="Collapsed" Content="Get Cable A+B ↗" Click="LicenseClick"/></WrapPanel>
    <TextBlock x:Name="DeviceHint" TextWrapping="Wrap" Margin="0,3,0,10"/>
     </StackPanel></TabItem>
     <TabItem Header="Voice"><StackPanel TextElement.FontWeight="Normal" TextElement.Foreground="#F3EAFF">
    <TextBlock Text="Interpreter voices" Style="{StaticResource SectionTitle}"/>
    <TextBlock x:Name="SpeechState" Text="Sign in to use Codex realtime voices." Foreground="#D2B4EF" TextWrapping="Wrap" Margin="0,3,0,8"/>
    <TextBlock Text="Incoming · What you hear" Margin="0,8,0,4"/>
    <DockPanel><Button x:Name="Preview" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Preview" AutomationProperties.Name="Preview incoming voice" Click="PreviewClick"/><ComboBox x:Name="Voice" SelectionChanged="VoiceChanged" AutomationProperties.Name="Incoming translation voice"/></DockPanel>
    <TextBlock Text="Outgoing · What others hear" Margin="0,12,0,4"/>
    <DockPanel><Button x:Name="PreviewSend" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Preview" AutomationProperties.Name="Preview outgoing voice" Click="PreviewClick"/><ComboBox x:Name="SendVoice" SelectionChanged="VoiceChanged" AutomationProperties.Name="Outgoing translation voice"/></DockPanel>
    <TextBlock x:Name="RecorderHint" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#D2B4EF"/>
     </StackPanel></TabItem>
     <TabItem Header="Updates"><StackPanel TextElement.FontWeight="Normal" TextElement.Foreground="#F3EAFF">
      <TextBlock Text="Application updates" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="UpdateState" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Button x:Name="UpdateButton" HorizontalAlignment="Left" Content="Check for updates" Click="UpdateClick"/>
     </StackPanel></TabItem>
    </TabControl>
   </StackPanel>
   <ProgressBar x:Name="Transfer" Visibility="Collapsed" Height="6" Margin="0,8,0,0" Foreground="#BD8EFF"/>
   <Border CornerRadius="7" Padding="10,8" Margin="0,10,0,0" Background="#282332">
    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <TextBlock x:Name="Status" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Foreground="#E4D9ED"/>
   </Border>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
